# Configuración del Microservicio IA Recepción
# Copie este archivo a .env y ajuste los valores según su entorno

# Configuración del servidor API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RELOAD=false

# Configuración de Tesseract OCR
# Windows:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac:
# TESSERACT_CMD=/usr/bin/tesseract

# Configuración de procesamiento de imágenes
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/jpg,image/png,image/bmp,image/tiff
MAX_IMAGE_WIDTH=2000
MAX_IMAGE_HEIGHT=2000

# Configuración de logging
LOG_LEVEL=INFO
LOG_FILE=logs/microservicio.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Configuración de rendimiento
MAX_WORKERS=4
WORKER_TIMEOUT=30
KEEP_ALIVE=2

# Configuración de seguridad
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Configuración de caché
ENABLE_CACHE=true
CACHE_TTL=3600
CACHE_MAX_SIZE=100

# Configuración de base de datos (para futuras versiones)
# DATABASE_URL=sqlite:///./microservicio.db
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# Configuración de monitoreo
ENABLE_METRICS=false
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Configuración de desarrollo
DEVELOPMENT_MODE=false
ENABLE_PROFILING=false
DEBUG_SQL=false
