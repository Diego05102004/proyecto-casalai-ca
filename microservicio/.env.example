# Configuración de variables de entorno para FastAPI
# Copia este archivo a .env y configura los valores reales

# Token de autenticación para el microservicio de auditoría de recepción
# Debe tener al menos 32 caracteres
AUDITOR_RECEPCION_TOKEN=V2ULrTMDqWierxYc7i71JKpewJozqORhdI_JbmbsTVo

# Token de autenticación para el microservicio de analítica predictiva
# Debe tener al menos 32 caracteres
ANALITICA_PREDICTIVA_TOKEN=tu-token-analitica-aqui

# Configuración de base de datos MySQL para catálogo de productos y proveedores
# Tipo de adaptador: 'mysql' o 'csv'
BD_TIPO=mysql

# Configuración MySQL (usar si BD_TIPO=mysql)
BD_HOST=localhost
BD_PORT=3306
BD_USER=MicroserviceCAI
BD_PASSWORD=MSagente#26
BD_DATABASE=casalai_principal

# Configuración CSV fallback (usar si BD_TIPO=csv)
BD_RUTA_PRODUCTOS_CSV=conocimiento/catalogo_productos.csv
BD_RUTA_PROVEEDORES_CSV=conocimiento/proveedores.csv
