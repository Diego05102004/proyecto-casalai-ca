{
    "name": "usuario/proyecto-casalai-ca",
    "autoload": {
        "psr-4": {
            "Usuario\\ProyectoCasalaiCa\\": "Modelo/Usuario/ProyectoCasalaiCa",
            "Usuario\\ProyectoCasalaiCa\\Config\\": "Modelo/Config",
            "Usuario\\ProyectoCasalaiCa\\Modelo\\Clases\\": "Modelo/Usuario/ProyectoCasalaiCa/Clases"
        },
        "classmap": [
            "Modelo/Usuario/ProyectoCasalaiCa/Clases"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Usuario\\ProyectoCasalaiCa\\Test\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.4.0",
        "cboden/ratchet": "^0.4.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true
    }
}
