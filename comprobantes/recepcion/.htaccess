Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
    <FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>
</IfModule>