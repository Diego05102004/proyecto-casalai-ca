# Variables de entorno para el sistema de cifrado híbrido RSA+AES
# Copie este archivo a .env y configure los valores reales

# Microservicio de analítica predictiva local
ANALITICA_PREDICTIVA_URL=http://127.0.0.1:8000
# Configure el mismo secreto privado (mínimo 32 caracteres) en el proceso FastAPI.
ANALITICA_PREDICTIVA_TOKEN=4VkCEOifAvoTOsbB5xGP-Y3jy4CZY5VybRdOQa00Hb4

# WebSocket de notificaciones
# Generar el secreto con: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
WEBSOCKET_JWT_SECRET=
# Local: ws://127.0.0.1:8080
# AlwaysData: wss://services-TU_CUENTA.alwaysdata.net:8300
WEBSOCKET_PUBLIC_URL=
WEBSOCKET_PORT=8080
WEBSOCKET_BIND_ADDRESS=0.0.0.0
# Hosts que pueden iniciar el handshake (sin comodines), separados por coma
WEBSOCKET_ALLOWED_ORIGINS=localhost,127.0.0.1
# Para AlwaysData configura certificado y clave privada válidos para el host de servicios.
# WEBSOCKET_TLS_CERT=/home/TU_CUENTA/certs/fullchain.pem
# WEBSOCKET_TLS_KEY=/home/TU_CUENTA/certs/private.key

# Configuración de reCAPTCHA
RECAPTCHA_SECRET_KEY=6LcC6gsuAAAAAIXYvaEa3bDdLa91xbRjmVAbXZTy

# Claves RSA para cifrado híbrido (2048 bits)
# Generar usando: openssl genrsa -out private.pem 2048
# Generar clave pública: openssl rsa -in private.pem -pubout -out public.pem
#
# IMPORTANTE:
# - La clave privada debe mantenerse en secreto y nunca compartirse
# - La clave pública puede distribuirse libremente
# - En producción, use variables de entorno del sistema operativo en lugar de archivo .env
# - Nunca commit el archivo .env al repositorio git

RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA[REEMPLAZAR_CON_CLAVE_PUBLICA_REAL]
-----END PUBLIC KEY-----"

RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQD[REEMPLAZAR_CON_CLAVE_PRIVADA_REAL]
-----END PRIVATE KEY-----"
