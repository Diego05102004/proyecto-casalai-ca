# Copy to .env in this directory. Keep .env out of Git and outside the public web root.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=casalai.alwaysdata.net,localhost,127.0.0.1

# Generate a random secret of at least 32 bytes and keep it only in this private .env file.
JWT_SECRET_KEY=

# Generate a new 2048-bit RSA key pair for the API.
RSA_PUBLIC_KEY=""
RSA_PRIVATE_KEY=""

# Temporary key used only to read existing encrypted database values.
RSA_LEGACY_PRIVATE_KEY=""
